{
  "name": "grok-codex-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Use the local Codex CLI from Grok Build to review code or delegate tasks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinxlzc/grok-codex-plugin.git"
  },
  "homepage": "https://github.com/jinxlzc/grok-codex-plugin",
  "bugs": {
    "url": "https://github.com/jinxlzc/grok-codex-plugin/issues"
  },
  "author": {
    "name": "Kaworu",
    "email": "jinxlzc@foxmail.com",
    "url": "https://github.com/jinxlzc"
  },
  "keywords": [
    "grok",
    "grok-build",
    "codex",
    "openai-codex",
    "xai",
    "plugin",
    "mcp"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "mkdir -p plugins/codex/.generated/app-server-types && codex app-server generate-ts --out plugins/codex/.generated/app-server-types",
    "build": "tsc -p tsconfig.app-server.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
