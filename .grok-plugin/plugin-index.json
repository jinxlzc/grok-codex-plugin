{
  "version": 1,
  "plugins": {
    "codex": {
      "components": {
        "skills": [
          { "name": "codex-delegate", "description": "Delegate coding and review work to the local Codex CLI" },
          { "name": "codex-cli-runtime", "description": "Internal companion contract" },
          { "name": "codex-result-handling", "description": "Internal result presentation contract" },
          { "name": "gpt-5-4-prompting", "description": "Internal Codex prompt-shaping guidance" }
        ],
        "commands": [
          { "name": "setup", "description": "Check Codex CLI readiness" },
          { "name": "review", "description": "Run a Codex code review" },
          { "name": "adversarial-review", "description": "Run a challenge review" },
          { "name": "rescue", "description": "Delegate a task to Codex" },
          { "name": "transfer", "description": "Transfer this Grok session into Codex" },
          { "name": "status", "description": "Show Codex jobs" },
